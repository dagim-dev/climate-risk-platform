# Production environment variable template — set these in your cloud provider's
# secret manager. Never commit real values to the repository.
# Production cloud deploy is deferred; this file is scaffolding only.

# --- Backend (Google Cloud Run / Secret Manager) ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
NOAA_API_KEY=
GOOGLE_CLIENT_ID=
CORS_ORIGINS=https://climaterisk.io,https://www.climaterisk.io
ENVIRONMENT=production
APP_VERSION=2.0.0
SENTRY_DSN=
JWT_SECRET=
# PDFs are stored on the local container disk today. Move to GCS/S3 before
# a real Cloud Run deploy, or treat reports as ephemeral.

# --- Frontend (Vercel Environment Variables) ---
NEXT_PUBLIC_API_URL=https://api.climaterisk.io
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
AUTH_SECRET=
NEXTAUTH_URL=https://climaterisk.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
