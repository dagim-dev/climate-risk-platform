# Local dev only. Never commit a filled-in .env (it's gitignored — keep it that way).
# In production, don't put real secrets in an .env file at all: inject them via
# your host's secrets manager (e.g. GCP Secret Manager mounted as env vars on
# Cloud Run, or Vercel's encrypted Environment Variables UI for the frontend).

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/climate_risk
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
NOAA_API_KEY=
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
APP_VERSION=2.0.0
SENTRY_DSN=
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
API_BASE_URL=http://localhost:8000
