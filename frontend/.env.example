# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: backend URL for server-side calls (NextAuth login) when it differs from the
# browser URL, e.g. http://backend:8000 inside docker-compose.
API_INTERNAL_URL=

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET=change-me-in-development
AUTH_URL=http://localhost:3000
# Required when not deployed on Vercel (Docker, Cloud Run, self-hosted).
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Error monitoring (optional — set DSN from sentry.io project settings)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
